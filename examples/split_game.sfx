# ==============================================================================
# 🐰 Usakame External Sounds: split_game.sfx
# ------------------------------------------------------------------------------
# このファイルは split_game.rb から自動読み込みされる効果音・BGM定義です。
# VSCodeやテキストエディタで直接編集して保存すると即座にホットリロードされます！
# ==============================================================================

# 0: コイン取得音
@SFX 0
wave square
speed 3
b4:v12 e5:v15:fade

# 1: 足音 (超短パルスノイズ)
@SFX 1
wave noise
speed 2
c2:v8:fade

# 0: アイランドBGM (ch0: メロディ, ch1: ベース)
@MUSIC 0
speed 16
ch0: c4 e4 g4 e4 f4 a4 >c4< a4 g4 b4 >d4< b4 >c4 e4 g4 c4
ch1: c2 g2 c2 g2 f2 c3 f2 c3 g2 d3 g2 d3 c2 g2 c2 g2
